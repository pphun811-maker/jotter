<Window x:Class="Jotter.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Jotter"
        Width="400" SizeToContent="Height" MaxWidth="440" MinHeight="150"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- 让窗口背景透明、边框自己画圆角（DWM 圆角对 Transparent 底会露黑边，这里干脆全自绘） -->
  <Border Margin="1" BorderBrush="#FF2E2E2E" BorderThickness="1" CornerRadius="8"
          Background="#FF0F0F0F" Padding="18,16,18,16">
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold"
                 Foreground="#FFE0E0E0" TextWrapping="Wrap"/>
      <TextBlock x:Name="DetailText" FontSize="11.5" Foreground="#FF9A9A9A"
                 TextWrapping="Wrap" Margin="0,9,0,0"/>
      <TextBlock x:Name="HintText" FontSize="10.5" Foreground="#FF6A6A6A"
                 TextWrapping="Wrap" Margin="0,9,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="CancelBtn" Content="取消" MinWidth="64" Margin="0,0,8,0"
                Style="{StaticResource EntryOp}" FontSize="12" Padding="12,5"
                Click="CancelBtn_Click"/>
        <Button x:Name="ConfirmBtn" MinWidth="64"
                Style="{StaticResource EntryOp}" FontSize="12" FontWeight="SemiBold"
                Foreground="#FFC97A7A" Padding="12,5"
                Click="ConfirmBtn_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>

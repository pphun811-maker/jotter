<Window x:Class="Jotter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Jotter 速记"
        Width="480" Height="240"
        MinWidth="280" MinHeight="160"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="#FF0F0F0F"
        FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <!-- 无边框窗口的隐形拖拽边：外圈 6 DIP 命中区，视觉零改动 -->
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- 细滚动条：透明轨道 + 圆角深灰滑块，与整体灰阶一致 -->
    <Style x:Key="SlimVScroll" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#FF3D3D3D" CornerRadius="4" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- 圆角走 DWM（代码里设 CornerPreference），这里的 CornerRadius 与之对齐 -->
  <Border BorderBrush="#FF2E2E2E" BorderThickness="1" CornerRadius="8" Background="#FF0F0F0F">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="30" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Ellipse Width="5" Height="5" Fill="#FF6B6B6B" VerticalAlignment="Center"/>
          <TextBlock Text="J O T T E R" FontSize="9" FontWeight="SemiBold"
                     Foreground="#FF7A7A7A" Margin="7,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="TimestampText"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,16,0" FontSize="9.5"
                   Foreground="#FF4F4F4F"/>
      </Grid>

      <Border DockPanel.Dock="Bottom" Height="34"
              BorderBrush="#FF1D1D1D" BorderThickness="0,1,0,0">
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,16,0" FontSize="9.5"
                   x:Name="CounterText" Opacity="0.35">
          <Run x:Name="CountNum" Text="0" FontWeight="SemiBold" Foreground="#FFC9C9C9"/>
          <Run Text=" 字" Foreground="#FF8A8A8A"/>
        </TextBlock>
      </Border>

      <TextBox x:Name="InputBox"
               Background="Transparent" BorderThickness="0"
               Foreground="#FFF0F0F0" CaretBrush="#FFF0F0F0"
               SelectionBrush="#FF5A5A5A" SelectionTextBrush="#FFF0F0F0"
               FontSize="14" Padding="16,6,16,6"
               TextBlock.LineHeight="23" TextBlock.LineStackingStrategy="BlockLineHeight"
               AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               VerticalContentAlignment="Top"
               TextChanged="InputBox_TextChanged">
        <TextBox.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVScroll}"/>
        </TextBox.Resources>
      </TextBox>
    </DockPanel>
  </Border>
</Window>

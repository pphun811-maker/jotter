<Window x:Class="Jotter.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Jotter 笔记"
        Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F0F0F"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <!-- 与主弹窗同款：无边框 + 6 DIP 隐形拖拽边 -->
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- EntryOp 按钮样式已上移 App.xaml，与确认框共用 -->
  </Window.Resources>

  <!-- 圆角走 DWM（代码里设 CornerPreference），这里的 CornerRadius 与之对齐 -->
  <Border BorderBrush="#FF2E2E2E" BorderThickness="1" CornerRadius="8" Background="#FF0F0F0F">
    <DockPanel>
      <!-- 顶栏：字标 + 关闭 -->
      <Grid DockPanel.Dock="Top" Height="30" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Ellipse Width="5" Height="5" Fill="#FF6B6B6B" VerticalAlignment="Center"/>
          <TextBlock Text="J O T T E R" FontSize="9" FontWeight="SemiBold"
                     Foreground="#FF7A7A7A" Margin="7,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="CloseBtn" Width="30" Height="22"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,10,0" Content="×" FontSize="13" Cursor="Hand"
                Foreground="#FF6A6A6A" Click="CloseBtn_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#FF222222"/>
                  <Setter Property="Foreground" Value="#FFC9C9C9"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>

      <!-- 底部编辑条：点"修改"后出现，保存时周文档+总文档同步更新 -->
      <Border x:Name="EditBar" DockPanel.Dock="Bottom" Background="#FF161616"
              BorderBrush="#FF1D1D1D" BorderThickness="0,1,0,0" Padding="14,10,14,12"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="EditStamp" FontSize="10.5" Foreground="#FF8A8A8A"/>
          <TextBox x:Name="EditBox" Margin="0,7,0,0" MaxHeight="110"
                   Background="#FF101010" BorderBrush="#FF2E2E2E" BorderThickness="1"
                   Foreground="#FFF0F0F0" CaretBrush="#FFF0F0F0"
                   SelectionBrush="#FF5A5A5A" SelectionTextBrush="#FFF0F0F0"
                   FontSize="12.5" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   ContextMenu="{StaticResource TextBoxMenu}">
            <TextBox.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVScroll}"/>
            </TextBox.Resources>
          </TextBox>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
            <Button Content="取消" Style="{StaticResource EntryOp}" Click="EditCancel_Click"/>
            <Button Content="保存" Style="{StaticResource EntryOp}" Margin="6,0,0,0"
                    Click="EditSave_Click" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 左列表 + 右条目流 -->
      <Grid>
        <Grid.ColumnDefinitions>
          <!-- Auto：列表收起时整列归零，空态不留暗条 -->
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="FileList" Grid.Column="0" Width="180"
                 Background="#FF131313" BorderThickness="0"
                 SelectionChanged="FileList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False">
          <ListBox.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVScroll}"/>
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="#FF9A9A9A"/>
              <Setter Property="FontSize" Value="11.5"/>
              <Setter Property="Padding" Value="14,7,10,7"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#FF1B1B1B"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#FF262626"/>
                        <Setter Property="Foreground" Value="#FFE0E0E0"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="ListSplitter" Grid.Column="1" Width="1" Background="#FF1D1D1D"/>

        <DockPanel Grid.Column="2">
          <TextBlock x:Name="DocTitle" DockPanel.Dock="Top" FontSize="13" FontWeight="SemiBold"
                     Foreground="#FF8A8A8A" Margin="22,16,22,2"/>

          <!-- 每条速记一张卡片，单击选中露出 复制/修改/删除 -->
          <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
                   SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVScroll}"/>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <!-- 选中视觉交给卡片模板，容器保持透明 -->
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Background="Transparent">
                        <ContentPresenter/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Card" Margin="12,8,14,0" Padding="14,10,8,12"
                        CornerRadius="6" BorderThickness="1"
                        BorderBrush="#FF1D1D1D" Background="#FF141414">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding Stamp}" FontSize="12.5" FontWeight="Bold"
                                 Foreground="#FFC9C9C9" VerticalAlignment="Center"/>
                      <StackPanel x:Name="Ops" Orientation="Horizontal" HorizontalAlignment="Right"
                                  Visibility="Hidden">
                        <Button Content="复制" Style="{StaticResource EntryOp}" Click="CopyEntry_Click"/>
                        <Button Content="修改" Style="{StaticResource EntryOp}" Click="EditEntry_Click"/>
                        <Button Content="删除" Style="{StaticResource EntryOp}" Click="DeleteEntry_Click"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Body}" FontSize="12.5" Foreground="#FFD6D6D6"
                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <!-- 悬浮即显操作按钮，不必先选中；悬浮时卡片微亮，选中边框更亮 -->
                  <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                               Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF2E2E2E"/>
                    <Setter TargetName="Card" Property="Background" Value="#FF191919"/>
                    <Setter TargetName="Ops" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                               Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF3D3D3D"/>
                    <Setter TargetName="Card" Property="Background" Value="#FF1C1C1C"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- 空态 -->
        <StackPanel x:Name="EmptyHint" Grid.Column="0" Grid.ColumnSpan="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
          <TextBlock Text="还没有笔记" FontSize="13" Foreground="#FF6A6A6A"
                     HorizontalAlignment="Center"/>
          <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="10.5"
                     Foreground="#FF4A4A4A"
                     Text="按全局热键（默认 Ctrl+Alt+N）记下第一条吧"/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Border>
</Window>
